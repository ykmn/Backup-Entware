#!/opt/bin/sh
# v2026-09-27
set -eu
umask 077
# use sed -i 's/\r//g' /opt/etc/cron.daily/backup to fix Windows CR/LF line ends

PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin

### Settings
USB_LABEL="Kingston16G"
BACKUP_DIR="/tmp/mnt/${USB_LABEL}/backup"
DAYS=8

# Select components
IsNFQWS1=0
IsNFQWS2=1
IsSKeen=0
IsXKeen=1
IsXKeenUI=1
IsMihomo=1
IsXRay=0
IsConf=1
IsFirm=1
# ====================
TAG=Backup

if [ -t 1 ]; then
	RESET='\033[0m'    CYAN='\033[36m'    GREEN='\033[32m'
	YELLOW='\033[33m'  RED='\033[31m'     BOLD_RED='\033[1;31m'
	BOLD_YELLOW='\033[1;33m'              GRAY='\033[90m'
else
	RESET='' CYAN='' GREEN='' YELLOW='' RED='' BOLD_RED='' BOLD_YELLOW='' GRAY=''
fi

EchoLog() {
	local message="$1" color="$RESET"
	case "$message" in
		*"Starting"*)                      color="$CYAN" ;;
		*"complete"*|*"Done"*|*"finished"*)    color="$GREEN" ;;
		*"Skipping"*)                      color="$GRAY" ;;
		*"Warning"*)                       color="$YELLOW" ;;
		*"Error"*)                         color="$BOLD_RED" ;;
		*"is not changed"*)                color="$GRAY" ;;
		*"changed"*)                       color="$BOLD_YELLOW" ;;
	esac
	logger -t "$TAG" "$message" || :
	printf '%b\n' "${color}${TAG}: ${message}${RESET}"
}

# Validate paths used by the router CLI and cleanup.
case "$USB_LABEL" in
	''|*[!A-Za-z0-9_-]*) EchoLog "Error: USB_LABEL must contain only letters, digits, _ or -"; exit 1 ;;
esac
case "$DAYS" in
	''|*[!0-9]*) EchoLog "Error: DAYS must be a non-negative integer"; exit 1 ;;
esac
MOUNT_DIR="/tmp/mnt/${USB_LABEL}"
case "$BACKUP_DIR" in
	"$MOUNT_DIR"/*) ;;
	*) EchoLog "Error: BACKUP_DIR must be inside $MOUNT_DIR"; exit 1 ;;
esac
case "$BACKUP_DIR" in
	*/../*|*/./*|*/..|*/.|*/) EchoLog "Error: BACKUP_DIR must be a normalized path without a trailing slash"; exit 1 ;;
esac

# Reject symlink components before creating anything under the destination.
CHECK_PATH="$MOUNT_DIR"
REMAINING=${BACKUP_DIR#"$MOUNT_DIR"/}
while [ -n "$REMAINING" ]; do
	COMPONENT=${REMAINING%%/*}
	[ -n "$COMPONENT" ] || { EchoLog "Error: Empty BACKUP_DIR path component"; exit 1; }
	CHECK_PATH="$CHECK_PATH/$COMPONENT"
	[ ! -L "$CHECK_PATH" ] || { EchoLog "Error: Symlink in BACKUP_DIR: $CHECK_PATH"; exit 1; }
	case "$REMAINING" in
		*/*) REMAINING=${REMAINING#*/} ;;
		*) REMAINING="" ;;
	esac
done

# A leftover directory alone does not prove that the USB drive is mounted.
if [ ! -d "$MOUNT_DIR" ]; then
	EchoLog "Error: USB drive '${USB_LABEL}' not mounted!"
	exit 1
fi

REAL_MOUNT_DIR=$(readlink -f "$MOUNT_DIR") || {
	EchoLog "Error: cannot resolve mount path: $MOUNT_DIR"
	exit 1
}

if ! awk -v target="$REAL_MOUNT_DIR" '
	$2 == target { found = 1 }
	END { exit !found }
' /proc/mounts; then
	EchoLog "Error: USB drive '${USB_LABEL}' not mounted!"
	exit 1
fi

# mkdir is atomic and works without flock. A stale lock after a power loss
# must be removed manually after confirming no backup process is running.
LOCK_DIR=/tmp/entware-backup.lock
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	EchoLog "Error: backup lock exists at $LOCK_DIR; another run may be active"
	exit 1
fi
STAGING=""
FIRMWARE_TMP=""
cleanup_run() {
	local status="$?"
	trap - 0
	if [ -n "$STAGING" ] && [ -d "$STAGING" ]; then
		rm -rf "$STAGING" || :
	fi
	if [ -n "$FIRMWARE_TMP" ]; then
		rm -f "$FIRMWARE_TMP" || :
	fi
	rmdir "$LOCK_DIR" || :
	if [ "$status" -ne 0 ]; then
		EchoLog "Error: Backup failed; previous completed backups were preserved"
	fi
	exit "$status"
}
trap cleanup_run 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$BACKUP_DIR"
# Measure the existing mount and follow /opt if it is a symlink.
DF_OUTPUT=$(df -Pk "$MOUNT_DIR")
AVAIL=$(printf '%s\n' "$DF_OUTPUT" | awk 'NR==2 {print $4}')
DU_OUTPUT=$(du -sk /opt/.)
TOTAL_OPT=$(printf '%s\n' "$DU_OUTPUT" | awk 'NR==1 {print $1}')
case "$AVAIL:$TOTAL_OPT" in
	*[!0-9:]*|:*|*:) EchoLog "Error: Cannot determine available space or /opt size"; exit 1 ;;
esac
# Conservative estimate: archive + application copies + firmware/headroom.
REQUIRED=$((TOTAL_OPT * 2 + 65536))
if [ "$AVAIL" -lt "$REQUIRED" ]; then
	EchoLog "Error: Only $((AVAIL / 1024)) MiB free, estimated need ~$((REQUIRED / 1024)) MiB"
	exit 1
fi

ARCH=""
if ARCH_OUTPUT=$(opkg print-architecture 2>/dev/null); then
	ARCH=$(printf '%s\n' "$ARCH_OUTPUT" | awk '/^arch/ && $2 !~ /^(all|noarch)$/ {print $2; exit}')
fi
if [ -z "$ARCH" ] && ARCH_OUTPUT=$(readelf -h /opt/bin/opkg 2>/dev/null); then
	ARCH=$(printf '%s\n' "$ARCH_OUTPUT" | awk '/Machine:/ {print $2; exit}')
fi
case "$ARCH" in
	''|*[!A-Za-z0-9_.-]*) ARCH=unknown ;;
esac

### Apps Backup function:
backup_app() {
	local name="$1" enabled="$2"
	shift 2
	[ "$enabled" != "1" ] && { EchoLog "Skipping ${name} backup"; return 0; }
	EchoLog "Starting ${name} backup"
	while [ $# -ge 2 ]; do
		local src="$1" dst="$2"
		shift 2
		[ ! -e "$src" ] && { EchoLog "Warning: ${name}: ${src} not found, skipping"; continue; }
		mkdir -p "${DATEDIR}${dst%/*}" || { EchoLog "Error: mkdir failed for ${name}."; exit 1; }
		cp -rfL "$src" "${DATEDIR}${dst}" || { EchoLog "Error: ${name} copy failed"; exit 1; }
	done
	EchoLog "${name} backup complete"
}

# Start!

DATE=$(date +%Y-%m-%d)
# Keep the traditional date name for the first run; preserve repeat runs too.
RUN_NAME="$DATE"
if [ -e "$BACKUP_DIR/$RUN_NAME" ]; then
	RUN_NAME="${DATE}-$(date +%H%M%S)-$$"
fi
STAGING=$(mktemp -d "$BACKUP_DIR/.incomplete-XXXXXX")
DATEDIR="$STAGING/"

START_TIME=$(date +%s)
EchoLog "Starting backup | arch: ${ARCH} | target: ${BACKUP_DIR}"

# Backup Apps!

cd /opt

backup_app "NFQWS1" "$IsNFQWS1" \
	"/opt/etc/nfqws" "etc/nfqws"

backup_app "NFQWS2" "$IsNFQWS2" \
	"/opt/etc/nfqws2" "etc/nfqws2"

backup_app "SKeen" "$IsSKeen" \
	"/opt/etc/skeen/skeen.json" "etc/skeen/skeen.json" \
	"/opt/etc/skeen/config" "etc/skeen/config"

backup_app "Mihomo" "$IsMihomo" \
	"/opt/etc/mihomo/config.yaml" "etc/mihomo/config.yaml"

backup_app "XKeen" "$IsXKeen" \
	"/opt/etc/xkeen" "etc/xkeen"

backup_app "XKeenUI" "$IsXKeenUI" \
	"/opt/etc/xkeen-ui" "etc/xkeen-ui"

backup_app "XRay" "$IsXRay" \
	"/opt/etc/xray/configs" "etc/xray/configs"

# Complete backup of Entware image

ARCHIVE="${ARCH}-installer-${DATE}.tar.gz"
EchoLog "Starting Entware archive: ${ARCHIVE}"
# The staging directory keeps incomplete archives away from completed backups.
if [ -t 1 ] && command -v pv >/dev/null 2>&1; then
	tar -cf - -C /opt --exclude=./tmp --exclude=./var/run . \
		| pv -s "${TOTAL_OPT}k" -N "Archiving" \
		| gzip > "${DATEDIR}${ARCHIVE}" \
		|| { EchoLog "Error: Entware archive failed"; exit 1; }
else
	TAR_STATUS=0
	tar -czf "${DATEDIR}${ARCHIVE}" -C /opt --exclude=./tmp --exclude=./var/run . \
		|| TAR_STATUS="$?"
	case "$TAR_STATUS" in
		0) ;;
		1) EchoLog "Warning: Entware archive completed with tar warnings; some files changed during read" ;;
		*) EchoLog "Error: Entware archive failed"; exit 1 ;;
	esac
fi
gzip -t "${DATEDIR}${ARCHIVE}" \
	|| { EchoLog "Error: Entware archive integrity check failed"; exit 1; }
EchoLog "Entware archive complete"

# Backup running-config ---

if [ "$IsConf" = "1" ]; then
	EchoLog "Starting running-config backup"
	CONFIG_NEW="${DATEDIR}config-${DATE}"

	if ! command -v ndmc >/dev/null 2>&1; then
		EchoLog "Error: ndmc not found; running-config backup was requested"
		exit 1
	else
		ndmc -c "show running-config" > "$CONFIG_NEW" || { EchoLog "Error: ndmc failed"; exit 1; }

		[ -s "$CONFIG_NEW" ] || { EchoLog "Error: running-config is empty"; exit 1; }
		cp "$CONFIG_NEW" "${DATEDIR}.config-cur"
		gzip "$CONFIG_NEW"
		EchoLog "Running config backup complete"
	fi
else
	EchoLog "Skipping running-config backup"
fi

# Firmware
if [ "$IsFirm" = "1" ]; then
	EchoLog "Starting firmware backup"

	if ! command -v ndmc >/dev/null 2>&1; then
		EchoLog "Error: ndmc not found; firmware backup was requested"
		exit 1
	else
		FIRM_NEW="${DATEDIR}firmware-${DATE}"
		USB_RELPATH="${BACKUP_DIR#/tmp/mnt/${USB_LABEL}/}"
		FIRMWARE_TMP="$BACKUP_DIR/.firmware-${DATE}-$$"
		[ ! -e "$FIRMWARE_TMP" ] || { EchoLog "Error: firmware temp file already exists: $FIRMWARE_TMP"; exit 1; }

		if ! ndmc -c "copy flash:/firmware ${USB_LABEL}:${USB_RELPATH}/${FIRMWARE_TMP##*/}"; then
			rm -f "$FIRMWARE_TMP"
			EchoLog "Error: ndmc copy failed for firmware."
			exit 1
		fi
		if [ ! -s "$FIRMWARE_TMP" ]; then
			rm -f "$FIRMWARE_TMP"
			EchoLog "Error: firmware temp file missing or empty at ${FIRMWARE_TMP}"
			exit 1
		fi
		mv "$FIRMWARE_TMP" "$FIRM_NEW" || { rm -f "$FIRMWARE_TMP"; EchoLog "Error: cannot move firmware into staging."; exit 1; }

		[ -s "$FIRM_NEW" ] || { EchoLog "Error: firmware file missing or empty at ${FIRM_NEW}"; exit 1; }
		EchoLog "Firmware backup complete"
	fi
else
	EchoLog "Skipping firmware backup"
fi

# Publish only after all requested backups have succeeded.
FINAL_DIR="$BACKUP_DIR/$RUN_NAME"
[ ! -e "$FINAL_DIR" ] || { EchoLog "Error: destination already exists: $FINAL_DIR"; exit 1; }
mv "$STAGING" "$FINAL_DIR"
STAGING=""
DATEDIR="$FINAL_DIR/"

# Update compatibility copies atomically, after publishing the daily snapshot.
if [ -f "${DATEDIR}.config-cur" ]; then
	mv "${DATEDIR}.config-cur" "$BACKUP_DIR/config-cur"
fi
if [ -f "${DATEDIR}firmware-${DATE}" ]; then
	cp "${DATEDIR}firmware-${DATE}" "$BACKUP_DIR/.firmware-cur.part"
	mv "$BACKUP_DIR/.firmware-cur.part" "$BACKUP_DIR/firmware-cur"
fi

# Only completed snapshot directories are eligible; never the backup root.
EchoLog "Removing backups older than ${DAYS} days"
for SNAPSHOT in "$BACKUP_DIR"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*; do
	[ -d "$SNAPSHOT" ] && [ ! -L "$SNAPSHOT" ] || continue
	[ "$SNAPSHOT" != "$FINAL_DIR" ] || continue
	SNAPSHOT_NAME=${SNAPSHOT##*/}
	case "$SNAPSHOT_NAME" in
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*)
			SNAPSHOT_PID=${SNAPSHOT_NAME#????-??-??-??????-}
			case "$SNAPSHOT_PID" in ''|*[!0-9]*) continue ;; esac ;;
		*) continue ;;
	esac
	find "$SNAPSHOT" -maxdepth 0 -type d -mtime "+$DAYS" -exec rm -rf {} \;
done

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
SIZE=$(du -sh "$DATEDIR" | awk '{print $1}')
EchoLog "Backup finished | size: ${SIZE} | duration: $((DURATION / 60))m $((DURATION % 60))s"
